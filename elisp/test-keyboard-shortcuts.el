;;; test-keyboard-shortcuts.el --- Shell shortcut tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'shell)
(load (expand-file-name "keyboard-shortcuts.el"
                        (file-name-directory load-file-name)) nil t)

(ert-deftest to-shell-resets-a-live-dashed-shell ()
  (dolist (name '("-recs-" "-recs"))
    (with-temp-buffer
      (rename-buffer name t)
      (shell-mode)
      (let ((directory (expand-file-name "~/code/recs/"))
            sent-command)
        (cl-letf (((symbol-function 'cd) (lambda (directory) (setq default-directory directory)))
                  ((symbol-function 'comint-check-proc) (lambda (_) t))
                  ((symbol-function 'shell) (lambda (_) (ert-fail "Restarted live shell")))
                  ((symbol-function 'get-buffer-process) (lambda (_) 'shell-process))
                  ((symbol-function 'process-send-string)
                   (lambda (process command)
                     (should (eq process 'shell-process))
                     (setq sent-command command))))
          (to-shell))
        (should (equal default-directory directory))
        (should (equal sent-command
                       (format "cd -- %s && act\n" (shell-quote-argument directory))))))))

(ert-deftest to-shell-restarts-a-dead-dashed-shell-before-activating ()
  (with-temp-buffer
    (rename-buffer "-recs-" t)
    (shell-mode)
    (let (events)
      (cl-letf (((symbol-function 'cd) (lambda (directory) (setq default-directory directory)))
                ((symbol-function 'comint-check-proc) (lambda (_) nil))
                ((symbol-function 'shell)
                 (lambda (buffer)
                   (should (eq buffer (current-buffer)))
                   (should (equal default-directory (expand-file-name "~/code/recs/")))
                   (push 'restart events)))
                ((symbol-function 'get-buffer-process) (lambda (_) 'shell-process))
                ((symbol-function 'process-send-string)
                 (lambda (_ command)
                   (should (string-match-p " && act\n\\'" command))
                   (push 'activate events))))
        (to-shell))
      (should (equal (reverse events) '(restart activate))))))

(ert-deftest to-shell-keeps-project-switching-outside-dashed-shells ()
  (dolist (mode '(fundamental-mode shell-mode))
    (with-temp-buffer
      (rename-buffer (if (eq mode 'shell-mode) "*ordinary-shell*" "-recs-") t)
      (funcall mode)
      (let (selected)
        (cl-letf (((symbol-function 'find-file-upwards-base)
                   (lambda (_) (expand-file-name "~/code/recs/")))
                  ((symbol-function 'get-buffer) (lambda (_) t))
                  ((symbol-function 'switch-to-buffer)
                   (lambda (name) (setq selected name)))
                  ((symbol-function 'process-send-string)
                   (lambda (&rest _) (ert-fail "Sent an activation command"))))
          (to-shell))
        (should (equal selected "-recs-"))))))
